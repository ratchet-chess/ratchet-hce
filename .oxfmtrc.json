{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "engines/",
    "core/",
    "vendor/",
    "build/",
    "dist/",
    "tmp/",
    "node_modules/",
    "results/",
    "tools/texel/maps/",
    "bun.lock"
  ]
}
